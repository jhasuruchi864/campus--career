# ==========================================
# Campus Connect Environment Configuration
# ==========================================

# Backend Configuration
PROJECT_NAME="Campus Connect"
API_V1_STR="/api/v1"
SECRET_KEY="campus-connect-super-secret-key-change-in-production-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL with SQLite fallback)
# Production PostgreSQL example: postgresql://postgres:password@localhost:5432/campus_connect
# SQLite fallback default: sqlite:///./campus_connect.db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campus_connect"

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:8000/api/v1"
