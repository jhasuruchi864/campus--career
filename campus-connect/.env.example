# ==========================================
# Campus Connect Environment Configuration
# ==========================================

# Backend Configuration
PROJECT_NAME="Campus Connect"
API_V1_STR="/api/v1"
SECRET_KEY="campus-connect-super-secret-key-change-in-production-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Supabase PostgreSQL / Local PostgreSQL / SQLite fallback)
# Supabase Transaction Pooler (recommended):
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"
# Supabase Direct Connection:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
# Local PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campus_connect"

# Supabase API Configuration (Optional)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:8000/api/v1"
